<Project>
  <!-- Stops the Railroader mods' Directory.Build.props (one folder up) from applying: this isn't a game mod. -->
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <Version>0.3.9</Version>
  </PropertyGroup>
</Project>
